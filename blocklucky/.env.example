# Copier ce fichier en .env puis le remplir. Ne JAMAIS commiter .env.

# Accès au réseau Sepolia (Alchemy ou Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/VOTRE_CLE
# Clé privée d'un compte RÉSERVÉ AUX TESTS (jamais votre compte principal)
PRIVATE_KEY=
# Vérification du code source sur Etherscan
ETHERSCAN_API_KEY=

# Chainlink VRF v2.5 (Sepolia)
# ID de VOTRE souscription, créée sur https://vrf.chain.link (voir docs/deploiement-sepolia.md)
VRF_SUBSCRIPTION_ID=
# Valeurs officielles (docs.chain.link/vrf/v2-5/supported-networks, relevées le 02/11/2026).
# Facultatives : si vides, celles de scripts/lib/networkConfig.js sont utilisées.
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae

# Optionnel
REPORT_GAS=false
COINMARKETCAP_API_KEY=
# Mettre 1 seulement si binaries.soliditylang.org est inaccessible (réseau filtré)
SOLC_LOCAL=
