{
  "name": "blocklucky",
  "version": "1.0.0",
  "description": "BlockLucky : la loterie des fêtes de la ville d'EtherBay, transparente et vérifiable sur la blockchain (Chainlink VRF v2.5).",
  "private": true,
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "simulate": "hardhat run scripts/simulate.js --network localhost",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "frontend": "npm --prefix frontend run dev"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "hardhat": "2.29.1",
    "solc": "0.8.24"
  },
  "dependencies": {
    "@chainlink/contracts": "1.4.0",
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "17.4.2"
  }
}
