# Réseau utilisé par l'interface : 11155111 (Sepolia) ou 31337 (local).
# Par défaut : Sepolia si une adresse Sepolia existe dans src/contracts/addresses.json, sinon local.
VITE_CHAIN_ID=
# URL RPC publique pour LIRE l'état de la loterie sans portefeuille (Alchemy/Infura conseillé).
# Attention : cette URL est visible dans le navigateur, utilisez une clé restreinte à votre domaine.
VITE_SEPOLIA_RPC_URL=
